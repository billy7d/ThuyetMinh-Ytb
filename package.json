{
  "name": "vietdub-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time Vietnamese Dubbing Extension for Chrome and Firefox",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && node scripts/validate-extension-build.mjs",
    "validate:build": "node scripts/validate-extension-build.mjs",
    "build:chrome": "npm run build:chrome -w @vietdub/extension && node scripts/validate-extension-build.mjs",
    "build:firefox": "npm run build:firefox -w @vietdub/extension && node scripts/validate-extension-build.mjs",
    "build:backend": "npm run build -w @vietdub/backend",
    "test": "npm run test -w @vietdub/tests",
    "test:unit": "npm run test:unit -w @vietdub/tests",
    "test:integration": "npm run test:integration -w @vietdub/tests",
    "test:e2e": "npm run test:e2e -w @vietdub/tests",
    "test:e2e:chrome": "npm run test:e2e:chrome -w @vietdub/tests",
    "test:e2e:firefox": "npm run test:e2e:firefox -w @vietdub/tests",
    "benchmark": "npm run benchmark -w @vietdub/tests",
    "start:backend": "npm run start -w @vietdub/backend",
    "dev:server": "npm run start -w @vietdub/backend"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
