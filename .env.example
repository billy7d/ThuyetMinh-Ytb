# VietDub defaults to local, offline inference. Do not put API keys in the extension.
AI_MODE=local
CLOUD_PROVIDERS_ENABLED=false
PAID_API_ALLOWED=false
MAX_EXTERNAL_API_COST_USD=0

# Người vận hành tạo models/manifest.json sau khi xác nhận tải model và ghi checksum.
LOCAL_MODEL_MANIFEST=models/manifest.json
LOCAL_MODEL_ROOT=models

# Thay `python` bằng đường dẫn python.exe tuyệt đối nếu máy không có Python trong PATH.
# Worker nhận tham số dưới dạng mảng JSON và chạy từ root repository.
# Tổng --threads của ba worker không nên vượt số nhân CPU (mặc định cho CPU 6 nhân: STT 3, dịch 1, TTS 2);
# tranh chấp CPU làm STT chậm hơn thời gian thực và phụ đề trễ dồn.
LOCAL_STT_WORKER_COMMAND=python
LOCAL_STT_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","stt","--model-path","models/stt/faster-whisper-base.en","--threads","3","--compute-type","int8"]
LOCAL_TRANSLATION_WORKER_COMMAND=python
LOCAL_TRANSLATION_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","translation","--model-path","models/translation/opus-mt-en-vi","--threads","1"]
LOCAL_TTS_WORKER_COMMAND=python
LOCAL_TTS_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","tts","--model-path","models/tts/vieneu-v3-turbo","--codec-path","models/tts/vieneu-v3-turbo/codec","--threads","2","--voice","Trúc Ly"]
# Hồ sơ GPU NVIDIA (đo trên GTX 1660 SUPER 6 GB + i5-9400F): cần `pip install -r runtime/requirements-gpu.txt`,
# tải thêm faster-whisper-small.en và chuyển OPUS-MT sang CTranslate2 (`python runtime/convert_translation_ct2.py ...`).
# STT small.en chạy GPU (0.42 s/lượt nói 3.5 s), lỗi GPU thì tự lùi về base.en trên CPU; dịch chạy GPU (~60 ms/câu);
# CPU còn lại dành cho giọng đọc VieNeu (4 luồng) và trình duyệt.
# LOCAL_STT_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","stt","--model-path","models/stt/faster-whisper-small.en","--cpu-model-path","models/stt/faster-whisper-base.en","--device","auto","--gpu-compute-type","int8_float16","--threads","2","--compute-type","int8","--beam-size","3","--glossary-file","runtime/glossary.example.json"]
# LOCAL_TRANSLATION_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","translation","--model-path","models/translation/opus-mt-en-vi","--ct2-model-path","models/translation/opus-mt-en-vi-ct2","--device","auto","--threads","2"]
# Tùy chọn chất lượng cao hơn (A/B 40 câu: vinai-translate-en2vi-v2 ít lỗi hơn OPUS-MT rõ rệt, ~+20 ms). Giấy phép AGPL-3.0:
# dùng cá nhân thì ổn, phân phối model hoặc cung cấp như dịch vụ mạng phải tuân thủ AGPL. Cần sửa mục translation trong manifest
# (modelId/revision/hash/license) và chuyển CTranslate2 bằng runtime/convert_translation_ct2.py --quantization int8_float16.
# --glossary-file cũng áp dụng mục "translations" (giữ thuật ngữ khi dịch) cho worker dịch và mục "pronunciations" (tùy chọn) cho worker TTS.
# Phụ đề tự động YouTube (không dấu câu) cho chế độ đọc trước: thêm "--punct-model-path","models/punct/pcs_en" vào worker dịch. Mô hình
# 1-800-BAD-CODE/punctuation_fullstop_truecase_english (Apache-2.0, ~210 MB: punct_cap_seg_en.onnx + spe_32k_lc_en.model), chỉ nạp khi
# gặp video chỉ có phụ đề tự động (~300 MB RAM trong worker dịch). Không có tham số này thì video đó dùng nhận dạng giọng nói như cũ.
# LOCAL_TRANSLATION_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","translation","--model-path","models/translation/vinai-translate-en2vi-v2","--ct2-model-path","models/translation/vinai-translate-en2vi-v2-ct2","--device","auto","--threads","2","--glossary-file","glossary.json","--punct-model-path","models/punct/pcs_en"]
# LOCAL_TTS_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","tts","--model-path","models/tts/vieneu-v3-turbo","--codec-path","models/tts/vieneu-v3-turbo/codec","--threads","4","--voice","Trúc Ly"]
LOCAL_WORKER_STARTUP_TIMEOUT_MS=90000
LOCAL_WORKER_REQUEST_TIMEOUT_MS=90000
LOCAL_WORKER_MAX_QUEUE=32
LOCAL_WORKER_MAX_FRAME_BYTES=2097152
# stderr của worker (traceback lỗi suy luận) ghi vào worker-<role>.log; mặc định <thư mục cha của LOCAL_MODEL_ROOT>/logs.
# LOCAL_WORKER_LOG_DIR=E:/VietDub-AI/logs

LOCAL_STT_SAMPLE_RATE=16000
LOCAL_STT_CHANNELS=1
# Audio được gom khi worker STT bận; vượt quá ngưỡng thì bỏ phần cũ nhất (cảnh báo, không dừng phiên).
LOCAL_STT_MAX_BUFFERED_MS=8000
LOCAL_STT_MAX_REQUEST_MS=4000
LOCAL_TRANSLATION_TIMEOUT_MS=20000
LOCAL_TRANSLATION_MAX_PENDING_CHARACTERS=1200
LOCAL_TRANSLATION_MAX_TRANSLATION_CHARACTERS=2400
LOCAL_TRANSLATION_MAX_CONTEXT_ITEMS=5
LOCAL_TTS_TIMEOUT_MS=90000
LOCAL_TTS_MAX_CONCURRENT_REQUESTS=1
# Số tiến trình TTS chạy song song (mặc định 1, tối đa 4). Mỗi tiến trình nạp một bản model riêng (RAM gấp đôi).
# Nếu đặt 2: đặt LOCAL_TTS_MAX_CONCURRENT_REQUESTS=2 và giảm --threads của TTS xuống 3 để tổng luồng không vượt số nhân CPU.
LOCAL_TTS_WORKER_PROCESSES=1
# Chờ phần nối tiếp của mảnh câu dở (bị cắt giữa lúc đang nói, thiếu dấu câu) để dịch trọn câu, tránh ngắt sai chỗ làm đổi nghĩa.
# Trễ thêm ~1.5 s ở giọng nói dày; đặt false để dịch ngay như bản cũ.
LOCAL_TRANSLATION_HOLD_FRAGMENTS=true
# Câu thuyết minh dài (>=90 ký tự) được tổng hợp và phát từng vế ở dấu phẩy để giọng đọc bắt đầu sớm hơn (~1 s trung vị, ~3 s với câu dài).
# Đặt false để đọc nguyên câu một đoạn.
LOCAL_TTS_STREAM_PARTS=true
# Giọng đọc dạng luồng: worker gửi âm thanh từng đoạn ngay khi sinh ra, có tiếng sau ~0.5 s thay vì đợi cả câu (đoạn cắt ở dấu phẩy ở trên chỉ còn
# dùng khi tắt mục này hoặc provider không hỗ trợ luồng). Không tốn thêm RAM (tiến trình TTS 1.40 GB so với 1.79 GB khi đọc cả câu). Đặt false để tổng hợp cả câu rồi mới gửi.
LOCAL_TTS_STREAM_AUDIO=true
# Giọng đọc chạy một phần trên GPU: thêm "--tts-gpu-libs","<thư mục onnxruntime-gpu>" vào LOCAL_TTS_WORKER_ARGS của worker TTS (cách cài: runtime/requirements-gpu.txt).
# Tự lùi về CPU nếu thiếu thư viện hoặc lỗi CUDA.
LOCAL_TTS_SAMPLE_RATE=48000

PORT=8080
# 0 = không giới hạn thời lượng phiên (chạy local không tốn phí). Đặt số phút nếu muốn tự dừng.
MAX_SESSION_MINUTES=0
# Số đoạn audio (250 ms) tối đa mỗi giây; bình thường 4, dư để chịu được lúc tab nền gửi dồn.
MAX_AUDIO_CHUNKS_PER_SECOND=200

# Explicit cloud diagnostics are disabled by default. They are never used as
# an automatic fallback when local inference fails.
# AI_MODE=cloud
# CLOUD_PROVIDERS_ENABLED=true
# PAID_API_ALLOWED=true
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en-US
# DEEPGRAM_SAMPLE_RATE=16000
# DEEPGRAM_CHANNELS=1
# DEEPGRAM_ENDPOINTING_MS=450
# DEEPGRAM_UTTERANCE_END_MS=1000
# DEEPGRAM_CONNECTION_TIMEOUT_MS=8000
# DEEPGRAM_MAX_RECONNECT_ATTEMPTS=2
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_TIMEOUT_MS=12000
# GEMINI_MAX_OUTPUT_TOKENS=512
# GOOGLE_CLOUD_TTS_API_KEY=
# GOOGLE_CLOUD_TTS_ACCESS_TOKEN=
# GOOGLE_CLOUD_TTS_LANGUAGE=vi-VN
# GOOGLE_CLOUD_TTS_VOICE=vi-VN-Standard-A
# GOOGLE_CLOUD_TTS_SAMPLE_RATE=24000
# GOOGLE_CLOUD_TTS_TIMEOUT_MS=15000
# MAX_COST_PER_SESSION_USD=2

# Khóa API addons.mozilla.org để ký bản Firefox cài cố định (npm run sign:firefox, xem README). Backend không dùng hai biến này.
# WEB_EXT_API_KEY=user:12345:678
# WEB_EXT_API_SECRET=
