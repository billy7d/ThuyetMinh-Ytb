# VietDub defaults to local, offline inference. Do not put API keys in the extension.
AI_MODE=local
CLOUD_PROVIDERS_ENABLED=false
PAID_API_ALLOWED=false
MAX_EXTERNAL_API_COST_USD=0

# Người vận hành tạo models/manifest.json sau khi xác nhận tải model và ghi checksum.
LOCAL_MODEL_MANIFEST=models/manifest.json
LOCAL_MODEL_ROOT=models

# Thay `python` bằng đường dẫn python.exe tuyệt đối nếu máy không có Python trong PATH.
# Worker nhận tham số dưới dạng mảng JSON và chạy từ root repository.
LOCAL_STT_WORKER_COMMAND=python
LOCAL_STT_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","stt","--model-path","models/stt/faster-whisper-base.en","--threads","6","--compute-type","int8"]
LOCAL_TRANSLATION_WORKER_COMMAND=python
LOCAL_TRANSLATION_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","translation","--model-path","models/translation/opus-mt-en-vi","--threads","6"]
LOCAL_TTS_WORKER_COMMAND=python
LOCAL_TTS_WORKER_ARGS=["runtime/workers/vietdub_worker.py","--role","tts","--model-path","models/tts/vieneu-v3-turbo","--codec-path","models/tts/vieneu-v3-turbo/codec","--threads","6","--voice","Minh Đức"]
LOCAL_WORKER_STARTUP_TIMEOUT_MS=90000
LOCAL_WORKER_REQUEST_TIMEOUT_MS=90000
LOCAL_WORKER_MAX_QUEUE=32
LOCAL_WORKER_MAX_FRAME_BYTES=2097152

LOCAL_STT_SAMPLE_RATE=16000
LOCAL_STT_CHANNELS=1
LOCAL_STT_MAX_PENDING_CHUNKS=12
LOCAL_TRANSLATION_TIMEOUT_MS=20000
LOCAL_TRANSLATION_MAX_PENDING_CHARACTERS=1200
LOCAL_TRANSLATION_MAX_TRANSLATION_CHARACTERS=2400
LOCAL_TRANSLATION_MAX_CONTEXT_ITEMS=5
LOCAL_TTS_TIMEOUT_MS=90000
LOCAL_TTS_MAX_CONCURRENT_REQUESTS=2
LOCAL_TTS_SAMPLE_RATE=48000

PORT=8080
MAX_SESSION_MINUTES=30
MAX_AUDIO_CHUNKS_PER_SECOND=10

# Explicit cloud diagnostics are disabled by default. They are never used as
# an automatic fallback when local inference fails.
# AI_MODE=cloud
# CLOUD_PROVIDERS_ENABLED=true
# PAID_API_ALLOWED=true
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en-US
# DEEPGRAM_SAMPLE_RATE=16000
# DEEPGRAM_CHANNELS=1
# DEEPGRAM_ENDPOINTING_MS=450
# DEEPGRAM_UTTERANCE_END_MS=1000
# DEEPGRAM_CONNECTION_TIMEOUT_MS=8000
# DEEPGRAM_MAX_RECONNECT_ATTEMPTS=2
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_TIMEOUT_MS=12000
# GEMINI_MAX_OUTPUT_TOKENS=512
# GOOGLE_CLOUD_TTS_API_KEY=
# GOOGLE_CLOUD_TTS_ACCESS_TOKEN=
# GOOGLE_CLOUD_TTS_LANGUAGE=vi-VN
# GOOGLE_CLOUD_TTS_VOICE=vi-VN-Standard-A
# GOOGLE_CLOUD_TTS_SAMPLE_RATE=24000
# GOOGLE_CLOUD_TTS_TIMEOUT_MS=15000
# MAX_COST_PER_SESSION_USD=2
