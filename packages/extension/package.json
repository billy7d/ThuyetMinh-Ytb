{
  "name": "@vietdub/extension",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "prebuild:chrome": "npm run build -w @vietdub/shared",
    "build:chrome": "node build.mjs --chrome",
    "prebuild:firefox": "npm run build -w @vietdub/shared",
    "build:firefox": "node build.mjs --firefox",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vietdub/shared": "*",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
